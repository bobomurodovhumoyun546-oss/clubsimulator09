# Use the SAME Turso database as Vercel so localhost and production share accounts.
# npm run dev / npm start load the project .env file. Server only; no VITE_ prefix.
TURSO_DATABASE_URL=libsql://your-database-your-account.turso.io
TURSO_AUTH_TOKEN=your-database-auth-token

# Optional isolated development only (creates a separate account database):
# CLUB_ACCOUNT_STORAGE=sqlite
