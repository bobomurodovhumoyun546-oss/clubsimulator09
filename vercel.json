{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "public/game-data/players.json"
    }
  },
  "routes": [
    {"handle": "filesystem"},
    {"src": "/api(?:/.*)?", "dest": "/api/index.js"},
    {"src": "/.*", "dest": "/index.html"}
  ]
}
